<Window x:Class="LanRemoteControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:LanRemoteControl.Views"
        Title="纸笺 · 局域网远控" Height="720" Width="1180"
        Background="{StaticResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource SansFont}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ========== 顶栏 ========== -->
        <Border Grid.Row="0" Padding="64,28,64,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 品牌 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,10,2"/>
                    <TextBlock Text="纸笺" FontFamily="{StaticResource SerifFont}" FontSize="22" FontWeight="Medium"
                               Foreground="{StaticResource InkBrush}"/>
                    <TextBlock Text="LAN REMOTE" Margin="12,2,0,0" FontSize="12" Foreground="{StaticResource InkFaintBrush}">
                        <TextBlock.LayoutTransform><ScaleTransform ScaleY="0.9"/></TextBlock.LayoutTransform>
                    </TextBlock>
                </StackPanel>

                <!-- Tab 切换 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="TabController" Content="远控端" Style="{StaticResource TabTextButton}" Click="Tab_Click" Tag="Active"/>
                    <Button x:Name="TabControlled" Content="被控端" Style="{StaticResource TabTextButton}" Click="Tab_Click"/>
                </StackPanel>

                <!-- 状态 -->
                <Border Grid.Column="2" Background="{StaticResource BgElevBrush}" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" Padding="12,6" CornerRadius="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusLamp" Style="{StaticResource StatusLamp}"/>
                        <TextBlock x:Name="StatusText" Text="未连接" Margin="8,0,0,0" FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" Foreground="{StaticResource InkSoftBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ========== 主区：双面板切换 ========== -->
        <Grid Grid.Row="1" Margin="64,32,96,48">
            <views:ControllerView x:Name="ControllerPanel" Visibility="Visible"/>
            <views:ControlledView x:Name="ControlledPanel" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
