<UserControl x:Class="LanRemoteControl.Views.ControllerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 左侧操作栏 ========== -->
        <StackPanel Grid.Column="0">
            <!-- 连接目标 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="连接目标" Style="{StaticResource CardLabel}"/>
                    <TextBox x:Name="IpInput" Style="{StaticResource IpInput}" Text="192.168.1.100"/>
                    <TextBlock Text="输入被控端局域网 IP，自动连接监听端口"
                               FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource InkFaintBrush}" Margin="0,8,0,0"/>
                    <Button x:Name="ConnectBtn" Content="建立连接" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="Connect_Click"/>
                </StackPanel>
            </Border>

            <!-- 控制模式 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="控制模式" Style="{StaticResource CardLabel}"/>
                    <StackPanel x:Name="ModeGroup">
                        <Border x:Name="ModeControl" Tag="Control" Margin="0,0,0,8" Padding="14,12"
                                Background="#FFF8EE" BorderBrush="{StaticResource InkBrush}"
                                BorderThickness="1" MouseLeftButtonDown="Mode_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="远程控制" FontSize="14" FontWeight="Medium" Foreground="{StaticResource InkBrush}"/>
                                    <TextBlock Text="完整键鼠操控权限" FontSize="11" Foreground="{StaticResource InkFaintBrush}"/>
                                </StackPanel>
                                <Ellipse Grid.Column="1" Width="14" Height="14" Stroke="{StaticResource LineBrush}" Fill="{StaticResource AccentBrush}"/>
                            </Grid>
                        </Border>
                        <Border x:Name="ModeView" Tag="View" Margin="0,0,0,8" Padding="14,12"
                                Background="{StaticResource BgElevBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" MouseLeftButtonDown="Mode_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="观看模式" FontSize="14" FontWeight="Medium" Foreground="{StaticResource InkBrush}"/>
                                    <TextBlock Text="仅画面传输，不操控" FontSize="11" Foreground="{StaticResource InkFaintBrush}"/>
                                </StackPanel>
                                <Ellipse Grid.Column="1" Width="14" Height="14" Stroke="{StaticResource LineBrush}"/>
                            </Grid>
                        </Border>
                        <Border x:Name="ModeFile" Tag="File" Padding="14,12"
                                Background="{StaticResource BgElevBrush}" BorderBrush="{StaticResource LineBrush}"
                                BorderThickness="1" MouseLeftButtonDown="Mode_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="文件传输" FontSize="14" FontWeight="Medium" Foreground="{StaticResource InkBrush}"/>
                                    <TextBlock Text="双向文件收发" FontSize="11" Foreground="{StaticResource InkFaintBrush}"/>
                                </StackPanel>
                                <Ellipse Grid.Column="1" Width="14" Height="14" Stroke="{StaticResource LineBrush}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- ========== 右侧主区 ========== -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 远程画面 -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="远程画面" FontFamily="{StaticResource SerifFont}" FontSize="16" FontWeight="Medium"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource InkSoftBrush}">
                                <Run Text="分辨率 "/><Run x:Name="MetaRes" Text="—" FontWeight="Medium" Foreground="{StaticResource InkBrush}"/>
                            </TextBlock>
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource InkSoftBrush}" Margin="16,0,0,0">
                                <Run Text="延迟 "/><Run x:Name="MetaLatency" Text="—" FontWeight="Medium" Foreground="{StaticResource InkBrush}"/>
                            </TextBlock>
                            <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource InkSoftBrush}" Margin="16,0,0,0">
                                <Run Text="码率 "/><Run x:Name="MetaBitrate" Text="—" FontWeight="Medium" Foreground="{StaticResource InkBrush}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" x:Name="ScreenBody" Background="#1A1A1A">
                        <Grid>
                            <!-- 远程画面 -->
                            <Image x:Name="RemoteImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighSpeed"/>
                            <!-- 占位提示（未连接时显示） -->
                            <StackPanel x:Name="ScreenPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="等待连接" Foreground="#6B6B6B" FontFamily="{StaticResource SerifFont}" FontSize="18" FontStyle="Italic" HorizontalAlignment="Center"/>
                                <TextBlock Text="ESTABLISH CONNECTION TO BEGIN" Foreground="#555" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <!-- 实时指示灯 -->
                            <Ellipse x:Name="LiveDot" Width="8" Height="8" Fill="{StaticResource RedBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Opacity="0"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 文件传输 -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="文件传输" FontSize="12" FontWeight="Medium" Foreground="{StaticResource InkSoftBrush}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="FileCount" Text="0 个文件" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource InkFaintBrush}"/>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" x:Name="FileDrop" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            Background="Transparent" Margin="0,12,0,0" Padding="16" MouseLeftButtonDown="FilePick_Click">
                        <TextBlock Text="拖拽文件至此处，或点击选择" FontSize="12" Foreground="{StaticResource InkFaintBrush}" HorizontalAlignment="Center"/>
                    </Border>
                    <ItemsControl Grid.Row="2" Grid.ColumnSpan="2" x:Name="FileList" Margin="0,12,0,0" MaxHeight="120">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" FontFamily="{StaticResource MonoFont}" FontSize="11" Text="{Binding Name}"/>
                                    <TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource InkFaintBrush}" Text="{Binding SizeDisplay}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
