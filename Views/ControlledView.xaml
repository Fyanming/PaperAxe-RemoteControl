<UserControl x:Class="LanRemoteControl.Views.ControlledView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ========== 左：监听控制 ========== -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 监听开关 -->
                <Border Grid.Row="0" x:Name="ListenToggle" Padding="20,16" Margin="0,0,0,24"
                        Background="#FFF8EE" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        MouseLeftButtonDown="Listen_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="开启被控" FontFamily="{StaticResource SerifFont}" FontSize="18" FontWeight="Medium"/>
                            <TextBlock Text="关闭后将拒绝所有新连接" FontSize="11" Foreground="{StaticResource InkSoftBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="ToggleSwitch" Width="40" Height="22" CornerRadius="11"
                                Background="{StaticResource LineBrush}" VerticalAlignment="Center">
                            <Border x:Name="ToggleKnob" Width="18" Height="18" CornerRadius="9"
                                    Background="{StaticResource BgElevBrush}" HorizontalAlignment="Left" Margin="2,2,0,0">
                                <Border.RenderTransform><TranslateTransform x:Name="KnobTrans" X="0"/></Border.RenderTransform>
                            </Border>
                        </Border>
                    </Grid>
                </Border>

                <!-- 监听端口 -->
                <StackPanel Grid.Row="1" Margin="0,0,0,24">
                    <TextBlock Text="监听端口" Style="{StaticResource CardLabel}" Margin="0,0,0,8"/>
                    <Border BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,1,0,1" Padding="0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PORT" FontSize="11" Foreground="{StaticResource InkFaintBrush}"
                                       VerticalAlignment="Bottom" Margin="0,0,12,4"/>
                            <TextBlock Grid.Column="1" x:Name="PortValue" Text="—" FontFamily="{StaticResource MonoFont}"
                                       FontSize="28" FontWeight="Medium" Foreground="{StaticResource InkBrush}"/>
                            <Border Grid.Column="2" x:Name="PortCopy" Background="Transparent" BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1" Padding="8,4" MouseLeftButtonDown="PortCopy_Click">
                                <TextBlock x:Name="PortCopyText" Text="复制" FontSize="11" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 已连接客户端 -->
                <StackPanel Grid.Row="2" Grid.RowSpan="2">
                    <TextBlock Text="已连接客户端" Style="{StaticResource CardLabel}" Margin="0,0,0,12"/>
                    <ItemsControl x:Name="ClientList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgBrush}" BorderBrush="{StaticResource LineSoftBrush}"
                                        BorderThickness="1" Padding="12,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Ip}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource InkBrush}"/>
                                        <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" Padding="8,2" Margin="8,0">
                                            <TextBlock Text="{Binding Mode}" FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="踢出" FontSize="11" Foreground="{StaticResource RedBrush}"
                                                   Margin="12,0,0,0" MouseLeftButtonDown="Kick_Click" Tag="{Binding Ip}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border x:Name="ClientEmpty" Background="Transparent" Padding="0,24">
                        <TextBlock Text="尚无连接" FontFamily="{StaticResource SerifFont}" FontSize="12" FontStyle="Italic"
                                   Foreground="{StaticResource InkFaintBrush}" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========== 右：音频设备管理 ========== -->
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="音频设备管理" Style="{StaticResource CardLabel}"/>

                <Border Grid.Row="1" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="当前输出设备" FontSize="12" Foreground="{StaticResource InkSoftBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock x:Name="AudioDeviceName" Text="扬声器（默认）" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center"/>
                            <Border x:Name="AudioBadge" Background="{StaticResource InkFaintBrush}" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock x:Name="AudioBadgeText" Text="空闲" FontSize="10" Foreground="{StaticResource BgElevBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="虚拟转发设备" FontSize="12" Foreground="{StaticResource InkSoftBrush}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="LFBolt Virtual Cable" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center"/>
                            <Border x:Name="VCableBadge" Background="{StaticResource InkFaintBrush}" Padding="6,2" Margin="8,0,0,0">
                                <TextBlock x:Name="VCableBadgeText" Text="未启用" FontSize="10" Foreground="{StaticResource BgElevBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="3" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="0,0,0,1" Padding="0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="系统音量" FontSize="12" Foreground="{StaticResource InkSoftBrush}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="VolValue" Text="80%" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                    </Grid>
                </Border>

                <Grid Grid.Row="4" Margin="0,16,0,16">
                    <Border Height="4" Background="{StaticResource LineBrush}" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80*"/>
                                <ColumnDefinition Width="20*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="VolFill" Grid.Column="0" Background="{StaticResource InkBrush}" Height="4"/>
                        </Grid>
                    </Border>
                </Grid>

                <TextBlock Grid.Row="5" Text="远控建立时：系统音量归零 → 切换输出至虚拟转发设备 → 远控端通过该设备接收被控端音频流。"
                           FontSize="11" Foreground="{StaticResource InkFaintBrush}" TextWrapping="Wrap" LineHeight="18"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
