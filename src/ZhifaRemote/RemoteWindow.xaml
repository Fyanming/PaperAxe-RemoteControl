<Window x:Class="ZhifaRemote.RemoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ZhifaRemote.Controls"
        Title="纸伐远控画面"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Background="#FF0B1014"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFont}"
        PreviewKeyDown="Window_OnPreviewKeyDown"
        PreviewKeyUp="Window_OnPreviewKeyUp">
    <Grid x:Name="RootGrid" Background="#FF0B1014">
        <Image x:Name="ScreenImage" Stretch="Uniform" Margin="0" Focusable="True"
               MouseMove="ScreenImage_OnMouseMove"
               MouseDown="ScreenImage_OnMouseDown"
               MouseUp="ScreenImage_OnMouseUp"
               MouseWheel="ScreenImage_OnMouseWheel"/>

        <Border x:Name="TopBar" VerticalAlignment="Top" Height="70" Background="#EA0D141B"
                BorderBrush="#2EFFFFFF" BorderThickness="0,0,0,1"
                Opacity="0" Panel.ZIndex="10">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:RippleButton x:Name="DisconnectButton" Style="{StaticResource DarkGhostButton}"
                                           Content="断开" Click="DisconnectButton_Click"/>
                    <TextBlock x:Name="TitleText" Foreground="White" FontSize="15" FontWeight="SemiBold"
                               Margin="14,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="#33FFFFFF" CornerRadius="12" Padding="4">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ControlRadio" Style="{StaticResource SegmentedRadio}"
                                         GroupName="RemoteMode" Content="操控" IsChecked="True"
                                         Foreground="#E8FFFFFF" Checked="RemoteMode_OnChecked"/>
                            <RadioButton x:Name="WatchRadio" Style="{StaticResource SegmentedRadio}"
                                         GroupName="RemoteMode" Content="观看"
                                         Foreground="#E8FFFFFF" Checked="RemoteMode_OnChecked"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#33FFFFFF" CornerRadius="12" Padding="4" Margin="14,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RemoteQualityLowRadio" Style="{StaticResource SegmentedRadio}"
                                         GroupName="RemoteQuality" Content="低" Foreground="#E8FFFFFF"
                                         Checked="RemoteQuality_OnChecked"/>
                            <RadioButton x:Name="RemoteQualityMediumRadio" Style="{StaticResource SegmentedRadio}"
                                         GroupName="RemoteQuality" Content="中" IsChecked="True" Foreground="#E8FFFFFF"
                                         Checked="RemoteQuality_OnChecked"/>
                            <RadioButton x:Name="RemoteQualityHighRadio" Style="{StaticResource SegmentedRadio}"
                                         GroupName="RemoteQuality" Content="高" Foreground="#E8FFFFFF"
                                         Checked="RemoteQuality_OnChecked"/>
                            <RadioButton x:Name="RemoteQualityUltraRadio" Style="{StaticResource SegmentedRadio}"
                                         GroupName="RemoteQuality" Content="极致" Foreground="#E8FFFFFF"
                                         Checked="RemoteQuality_OnChecked"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="RemoteFpsValueText" Foreground="#CCFFFFFF" FontSize="11"
                                   HorizontalAlignment="Center" Text="12 FPS"/>
                        <Slider x:Name="RemoteFpsSlider" Style="{StaticResource GlassSlider}" Width="120"
                                Minimum="5" Maximum="60" Value="12" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="RemoteFpsSlider_OnValueChanged"/>
                    </StackPanel>

                    <Border Background="#1FFFFFFF" CornerRadius="8" Padding="10,6" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="RemoteLatencyText" Foreground="#F2FFFFFF" FontSize="12"
                                   Text="延迟 -- ms"/>
                    </Border>

                    <controls:RippleButton x:Name="RemoteSendFileButton" Style="{StaticResource DarkGhostButton}"
                                           Content="文件" Margin="12,0,0,0" Click="RemoteSendFileButton_Click"/>
                    <controls:RippleButton x:Name="SettingsButton" Style="{StaticResource DarkGhostButton}"
                                           Content="设置" Margin="12,0,0,0" Click="SettingsButton_Click"/>
                    <controls:RippleButton x:Name="FullscreenButton" Style="{StaticResource DarkGhostButton}"
                                           Content="退出全屏" Margin="12,0,0,0" Click="FullscreenButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="BottomBar" VerticalAlignment="Bottom" Height="38" Background="#990B1014"
                Opacity="0" Panel.ZIndex="10">
            <TextBlock x:Name="StatusText" Foreground="#CCFFFFFF" FontSize="12" Margin="20,0"
                       VerticalAlignment="Center" Text="等待画面"/>
        </Border>

        <Border x:Name="SettingsPanel" Panel.ZIndex="20" VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,82,20,0" Width="380" Background="#F20F161D" BorderBrush="#73FFFFFF"
                BorderThickness="1" CornerRadius="12" Padding="18" Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <TextBlock Text="远控设置" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SettingsStatusText" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="#99FFFFFF" FontSize="11" Text="实时生效"/>
                </Grid>
                <Border Height="1" Background="#2EFFFFFF" Margin="0,12,0,12"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="隐私保护" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PrivacyStatusText" Foreground="#B8FFFFFF" FontSize="11"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="黑屏模式：被控端显示器熄灭，控制端画面不受影响"/>
                    </StackPanel>
                    <CheckBox x:Name="PrivacyToggle" Grid.Column="1" Style="{StaticResource GlassCheckBox}"
                              VerticalAlignment="Center"
                              Checked="PrivacyToggle_OnChanged" Unchecked="PrivacyToggle_OnChanged"/>
                </Grid>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="声音传输" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AudioStatusText" Foreground="#B8FFFFFF" FontSize="11"
                                   Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="开启：被控端系统声音实时回传到控制端"/>
                    </StackPanel>
                    <CheckBox x:Name="AudioToggle" Grid.Column="1" Style="{StaticResource GlassCheckBox}"
                              VerticalAlignment="Center"
                              Checked="AudioToggle_OnChanged" Unchecked="AudioToggle_OnChanged"/>
                </Grid>

                <TextBlock x:Name="VirtualDisplayStatusText" Foreground="#99FFFFFF" FontSize="11"
                           Margin="0,18,0,0" TextWrapping="Wrap" Text="正在检测虚拟显示器驱动…"/>
                <TextBlock x:Name="VirtualAudioStatusText" Foreground="#99FFFFFF" FontSize="11"
                           Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="未安装虚拟音频设备时，直接回传系统默认输出声音"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
